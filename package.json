{
  "name": "desyne",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "bun run registry:build && turbo build",
    "registry:build": "bun scripts/build-registry.ts && shadcn build -o apps/docs/public/r",
    "typecheck": "turbo typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "design:check": "bun packages/ui/scripts/check-design.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "shadcn": "^4.21.0",
    "turbo": "^2.11.4",
    "typescript": "^7.0.2"
  }
}
